{
  "expo": {
    "name": "Sisu",
    "slug": "Sisu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
  "expo-notifications",
  [
    "expo-location",
    {
      "locationWhenInUsePermission": "Allow Sisu to find veterinary clinics near you."
    }
  ]
],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.cedricraichand.Sisu"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0ba8e484-b335-424b-80b2-3eee665e51ec"
      }
    }
  }
}
